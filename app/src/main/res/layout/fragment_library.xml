<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/youScroll" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="12dp" android:paddingBottom="8dp" android:text="คุณ" android:textColor="@color/text1" android:textSize="22sp" android:textStyle="bold"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="8dp">
      <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
          android:text="ประวัติการเข้าชม" android:textColor="@color/text1" android:textSize="16sp" android:textStyle="bold"/>
      <TextView android:id="@+id/historyAll" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:padding="8dp" android:text="ดูทั้งหมด" android:textColor="@color/text2" android:textSize="13sp"
          android:background="?attr/selectableItemBackground"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/historyRow" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:clipToPadding="false"/>
    <TextView android:id="@+id/historyEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="8dp" android:text="ยังไม่มีวิดีโอที่ดู"
        android:textColor="@color/text2" android:textSize="13sp" android:visibility="gone"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="16dp" android:paddingBottom="4dp" android:text="เพลย์ลิสต์" android:textColor="@color/text1" android:textSize="16sp" android:textStyle="bold"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/playlistRow" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:clipToPadding="false"/>

    <LinearLayout android:id="@+id/downloadsBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/divider"/>
      <TextView android:id="@+id/downloadsTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp"
          android:text="การดาวน์โหลด" android:textColor="@color/text1" android:textSize="15sp" android:textStyle="bold"/>
      <LinearLayout android:id="@+id/downloads" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:background="@color/divider"/>
    <LinearLayout android:id="@+id/menuRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
  </LinearLayout>
</ScrollView>

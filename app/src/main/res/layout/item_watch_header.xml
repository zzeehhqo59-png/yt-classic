<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <LinearLayout android:id="@+id/titleRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
      android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:background="?attr/selectableItemBackground">
    <TextView android:id="@+id/wTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#0F0F0F" android:textSize="18sp" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/wViews" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#606060" android:textSize="13sp"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="12dp" android:paddingBottom="8dp">
    <TextView android:id="@+id/btnLike" style="@style/WatchAction" android:drawableTop="@drawable/ic_thumb_up" android:text="@string/like"/>
    <TextView android:id="@+id/btnDislike" style="@style/WatchAction" android:drawableTop="@drawable/ic_thumb_down" android:text="@string/dislike"/>
    <TextView android:id="@+id/btnShare" style="@style/WatchAction" android:drawableTop="@drawable/ic_share" android:text="@string/share"/>
    <TextView android:id="@+id/btnQuality" style="@style/WatchAction" android:drawableTop="@drawable/ic_tune" android:text="@string/quality"/>
  </LinearLayout>
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E5E5"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
    <ImageView android:id="@+id/wAvatar" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_avatar" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
      <TextView android:id="@+id/wChannel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#0F0F0F" android:textSize="15sp" android:maxLines="1" android:ellipsize="end"/>
      <TextView android:id="@+id/wSubs" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#606060" android:textSize="12sp"/>
    </LinearLayout>
    <TextView android:id="@+id/btnSubscribe" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/subscribe"
        android:textColor="#CC0000" android:textSize="14sp" android:textStyle="bold" android:padding="8dp" android:background="?attr/selectableItemBackground"/>
  </LinearLayout>
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E5E5"/>
  <TextView android:id="@+id/wDesc" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="12dp"
      android:textColor="#0F0F0F" android:textSize="13sp" android:maxLines="3" android:ellipsize="end" android:autoLink="web" android:lineSpacingExtra="2dp"/>
  <TextView android:id="@+id/wDescToggle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="12dp"
      android:text="@string/show_more" android:textColor="#606060" android:textSize="13sp" android:textStyle="bold"/>
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E5E5"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/up_next" android:textColor="#0F0F0F" android:textSize="15sp"/>
</LinearLayout>

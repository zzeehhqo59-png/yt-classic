<resources>
  <style name="Theme.YTClassic" parent="Theme.MaterialComponents.Light.NoActionBar">
    <item name="colorPrimary">#FFFFFF</item>
    <item name="colorPrimaryVariant">#E0E0E0</item>
    <item name="colorOnPrimary">#212121</item>
    <item name="colorSecondary">#FF0000</item>
    <item name="colorAccent">#FF0000</item>
    <item name="colorControlNormal">#606060</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowBackground">@android:color/white</item>
  </style>
  <style name="Theme.YTClassic.Watch" parent="Theme.YTClassic">
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">false</item>
  </style>
  <style name="NavText" parent="TextAppearance.MaterialComponents.Caption"><item name="android:textSize">11sp</item></style>
  <style name="WatchAction"><item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item><item name="android:layout_height">wrap_content</item><item name="android:gravity">center</item><item name="android:drawablePadding">4dp</item><item name="android:textColor">#606060</item><item name="android:textSize">12sp</item><item name="android:drawableTint">#606060</item><item name="android:background">?attr/selectableItemBackgroundBorderless</item><item name="android:paddingTop">4dp</item><item name="android:paddingBottom">4dp</item></style>
</resources>
